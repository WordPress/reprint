{
    "name": "wp-php-toolkit/reprint-server",
    "description": "Streaming export engine used by the Reprint Server WordPress plugin",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "replace": {
        "wp-php-toolkit/reprint-exporter": "self.version"
    },
    "require": {
        "php": ">=7.2"
    },
    "suggest": {
        "ext-pdo": "Needed for the SQLite export path; recommended for MySQL exports (the wpdb fallback handles MySQL when absent).",
        "ext-pdo_mysql": "Recommended for MySQL exports; falls back to wpdb when absent."
    },
    "autoload": {
        "psr-4": {
            "WordPress\\DataLiberation\\": "src/"
        },
        "classmap": [
            "src/class-database-rows-reader.php",
            "src/class-mysql-dump-producer.php",
            "src/class-file-index-processor.php",
            "src/class-file-tree-producer.php",
            "src/class-hmac-client.php",
            "src/class-hmac-server.php",
            "src/class-http-server.php",
            "src/class-multipart-processor.php",
            "src/class-push-configuration-exception.php",
            "src/class-push-exception.php",
            "src/class-push-endpoints.php",
            "src/class-push-session.php",
            "src/class-sqlite-driver-pdo.php",
            "src/class-wpdb-driver-pdo.php"
        ],
        "files": [
            "src/utils.php",
            "src/class-pdo-polyfill.php"
        ]
    }
}
